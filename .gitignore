# aiaikit ignore rules

# Local aiaikit prompts cache
.aiaikit/

# --- Go standard patterns ---
# Compiled binaries
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binaries and profiles
*.test
*.out
coverage.out
coverage.html

# Go workspace files (Go 1.18+)
go.work
go.work.sum

# Dependency directories
vendor/

# --- Build artifacts ---
bin/

# --- Universal patterns ---
.DS_Store
Thumbs.db
*.tmp
*.swp
*.swo
.vscode/
.idea/

# --- Environment overrides ---
.env
.env.local
.env.*.local

# --- Local logs ---
*.log